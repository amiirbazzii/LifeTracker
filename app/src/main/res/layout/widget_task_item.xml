<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_task_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_item_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="8dp"
    android:paddingTop="8dp"
    android:paddingRight="8dp"
    android:paddingBottom="8dp">

    <!-- Toggle Checkbox Button -->
    <TextView
        android:id="@+id/widget_task_checkbox"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:gravity="center"
        android:text="○"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:typeface="monospace" />

    <!-- Task Title & Tag -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="SAMPLE TASK"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/widget_task_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RECURRING"
            android:textColor="#71717A"
            android:textSize="9sp"
            android:typeface="monospace" />
    </LinearLayout>

    <!-- Points / Status Label -->
    <TextView
        android:id="@+id/widget_task_points"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:text="+10 PTS"
        android:textColor="#A1A1AA"
        android:textSize="10sp"
        android:textStyle="bold"
        android:typeface="monospace" />
</LinearLayout>
